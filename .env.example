# URL pública da API (vazio = usa proxy Nitro interno)
VITE_API_BASE_URL=

# URL interna do .NET API usada pelo Nitro para proxy server-side
NUXT_INTERNAL_API_URL=http://localhost:8080

# WebSockets
VITE_PRESENCE_WS_URL=
VITE_WS_URL=

# Dev auth: true = /dev-login em vez de redirecionar para auth.santos-tech.com
# A tela de login local faz proxy via /dev-auth/* → https://auth.santos-tech.com
NUXT_PUBLIC_DEV_AUTH=true
